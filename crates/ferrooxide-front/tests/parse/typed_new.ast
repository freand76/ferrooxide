module test ();
  // imports $unit
  class B;
    int(32) signed x = 1;
    function automatic integer signed get;
      return this.x;
    endfunction
  endclass
  class D extends B;
    int(32) signed y;
    function automatic reg new;
      input int(32) signed v = 5;
      begin
        this.x = (10 + v);
        this.y = v;
      end
    endfunction
    function automatic integer signed get;
      return (this.x + this.y);
    endfunction
  endclass
  int(32) signed fails = 0;
  class B b;
  class D d;
  initial begin
    b = B::new();
    if ((b.x != 1)) begin
      $display("FAILED B::new %0d", b.x);
      fails = (fails + 1);
    end
    b = D::new(2);
    if (((b.x != 12) || (b.get() != 12))) begin
      $display("FAILED D::new(2) %0d", b.x);
      fails = (fails + 1);
    end
    d = D::new();
    if (((d.x != 15) || (d.y != 5))) begin
      $display("FAILED DT::new %0d %0d", d.x, d.y);
      fails = (fails + 1);
    end
    d = D::new();
    if ((d.get() != 20)) begin
      $display("FAILED D::new() %0d", d.get());
      fails = (fails + 1);
    end
    if ((fails == 0))
      $display("PASSED");
  end
endmodule
