module m ();
  // imports $unit
  class B b;
  int(32) signed a, ok;
  initial begin
    ok = b.randomize(b.x) with { (b.x > a); };
    void'(b.randomize());
    ok = std::randomize(a) with { a inside {[1:3]}; };
    begin
      automatic reg [63:0] $randcase1;
      if (((1 + (a + 1)) != 0)) begin
        $randcase1 = $urandom_range(((1 + (a + 1)) - 1), 0);
        begin
          if (($randcase1 < 1))
            a = 1;
          else
            if (($randcase1 < (1 + (a + 1))))
              a = 2;
        end
      end
    end
  end
endmodule
package $unit ();
  class B;
    int(32) signed x;
    bit [3:0] k;
    int(8) signed arr[0:(4 - 1)];
    int(32) signed lim;
    // rand x
    // randc k
    // rand arr
    constraint c1 { (this.x > 0); soft (this.x < this.lim); }
    constraint c2 { this.x inside {1, [3:5]}; this.x dist {1 := 2, [3:5] :/ 1}; }
    constraint c3 { (this.lim > 2) -> { (this.x == 1); } if ((this.lim == 0)) { (this.x != 2); } else { (this.x != 3); } }
    constraint c4 { foreach (this.arr[i]) { (this.arr[i] == i); } unique {this.x, this.lim}; solve ... before ...; }
    constraint c5 { soft ((!(this.lim > 2)) || (this.x == 1)); }
    function automatic integer signed f;
      input int(32) signed y;
      return this.randomize() with { (this.x < y); };
    endfunction
  endclass
endpackage
