module m ();
  // imports $unit
  reg [(C.W - 1):0] x;
  class C c;
  initial
    x = ((C::W + c.W) + C::B1);
endmodule
package $unit ();
  class C;
    localparam W = 8;
    localparam signed [31:0] A = 0;
    localparam signed [31:0] B0 = (A + 1);
    localparam signed [31:0] B1 = (B0 + 1);
    reg [(C.W - 1):0] data;
    int(32) signed st;
  endclass
endpackage
