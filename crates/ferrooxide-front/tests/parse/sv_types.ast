module top (clk);
  // imports p, $unit
  parameter type T = reg [3:0];
  input wire clk;
  reg type(reg struct { reg [3:0] hi; reg enum {A, B, C} [1:0] lo; }) [5:0] s;
  reg type(reg union { reg [5:0] v; reg struct { reg [3:0] hi; reg enum {A, B, C} [1:0] lo; } s; }) [5:0] u;
  reg type(reg struct { reg [3:0] hi; reg enum {A, B, C} [1:0] lo; }) [5:0] arr[0:(2 - 1)];
  reg type T tp;
  int(32) signed i;
  bit [(W - 1):0] bv;
  reg [1:0] e;
  string str;
  always_comb begin
    s = '{hi: 4'h3, lo: B};
    u.s.hi = s.hi;
    arr[1].lo = e;
    i = ($__cast(32, 1, s) + p.dbl(3));
    bv = $__cast(8, 2, i);
    e = $__cast(2, 0, ((e === A) ? B : ((e === B) ? C : ((e === C) ? A : 'x))));
    str = "abc";
  end
  always_ff
    @(posedge clk) begin
      case (1'b1)
        (e ==? A), ((e >= B) && (e <= C)):
          i <= (i + 1);
        default:
          i <= 0;
      endcase
      i = (i + 1);
      i = (i + 2);
    end
  initial begin
    begin
      int(32) signed k;
      for (k = 0; ((0 >= (2 - 1)) ? (k >= (2 - 1)) : (k <= (2 - 1))); k = ((0 >= (2 - 1)) ? (k - 1) : (k + 1)))
        arr[k] = '0;
    end
    begin
      int(32) signed j;
      for (j = 0; (j < (((0 >= (2 - 1)) ? (0 - (2 - 1)) : (2 - 1)) + 1)); j = (j + 1)) begin
        if (((j ==? 0) || (j ==? 1)))
          continue;
        break;
      end
    end
    do
      i = (i - 1);
    while ((i > 0));
    $display("%0d %0d", 6, (W - 1));
  end
endmodule
package p ();
  localparam [1:0] A = 0;
  localparam [1:0] B = 2;
  localparam [1:0] C = (B + 1);
  parameter integer signed W = 8;
  function automatic integer signed dbl;
    input int(32) signed x;
    return (2 * x);
  endfunction
endpackage
