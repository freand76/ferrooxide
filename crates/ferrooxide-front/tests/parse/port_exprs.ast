module sel ($port1, lo, $port3);
  // imports $unit
  input wire(implicit) [7:0] a;
  output wire(implicit) [7:0] b;
  assign b = {(a[7:4] + 4'd1), a[3:0]};
  input wire(implicit) [($bits(a[7:4]) - 1):0] $port1;
  assign a[7:4] = $port1;
  input wire(implicit) [($bits(a[1:0]) - 1):0] lo;
  assign a[1:0] = lo;
  output wire(implicit) [($bits(b[3:0]) - 1):0] $port3;
  assign $port3 = b[3:0];
endmodule
module cat ($port1, o);
  // imports $unit
  input wire(implicit) [1:0] x;
  input wire(implicit) [3:0] y;
  output wire(implicit) p;
  output wire(implicit) [2:0] q;
  assign {p, q} = {x, y[2:1]};
  input wire(implicit) [($bits({x, y[2:1]}) - 1):0] $port1;
  assign {x, y[2:1]} = $port1;
  output wire(implicit) [($bits({p, q}) - 1):0] o;
  assign o = {p, q};
endmodule
module test ();
  // imports $unit
  reg [3:0] hi = 4'h9;
  reg [1:0] lo = 2'b10;
  wire [3:0] b;
  reg [3:0] in = 4'b1011;
  wire [3:0] o;
  int(32) signed fails = 0;
  sel s(hi, lo, b);
  sel s2(.lo(lo));
  cat c(in, o);
  initial begin
    #(1)
      ;
    if ((s.a !== 8'b1001zz10)) begin
      $display("FAILED a=%b", s.a);
      fails = (fails + 1);
    end
    if (((b !== 4'bzz10) || (s2.a !== 8'bzzzzzz10))) begin
      $display("FAILED b=%b", b);
      fails = (fails + 1);
    end
    if (((o !== 4'b1011) || (c.y !== 4'bz11z))) begin
      $display("FAILED o=%b y=%b", o, c.y);
      fails = (fails + 1);
    end
    hi = 4'h3;
    lo = 2'b01;
    #(1)
      ;
    if (((s.a !== 8'b0011zz01) || (b !== 4'bzz01))) begin
      $display("FAILED a=%b b=%b", s.a, b);
      fails = (fails + 1);
    end
    if ((fails == 0))
      $display("PASSED");
  end
endmodule
